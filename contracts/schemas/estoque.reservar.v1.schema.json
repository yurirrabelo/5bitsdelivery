{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delivery-tracker.local/schemas/estoque.reservar.v1.schema.json",
  "title": "Payload de estoque.reservar (v1)",
  "type": "object",
  "required": ["pedidoId"],
  "properties": {
    "pedidoId": { "type": "integer", "minimum": 1 },
    "clienteId": { "type": "string" },
    "cupom": { "type": "boolean", "description": "true: o pedido usa um dos itens com cupom; false ou ausente: um item normal" }
  }
}
