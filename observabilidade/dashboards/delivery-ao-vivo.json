{
 "uid": "delivery-ao-vivo",
 "title": "Detalhes técnicos (para perguntas)",
 "tags": [
  "delivery"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "editable": true,
 "graphTooltip": 1,
 "description": "O painel completo, para quando alguém perguntar: filas, DLQs, outbox, réplicas, mensagens duplicadas e logs.",
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "1. Pedidos e estoque",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "bargauge",
   "title": "Pedidos por status (total de transições)",
   "description": "Quantas vezes cada status foi alcançado: todo pedido passa por RECEBIDO e segue o seu caminho.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (status) (delivery_pedidos_transicoes_total)",
     "legendFormat": "{{status}}",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Estoque da promoção",
   "description": "disponivel + reservado + vendido = total. Uma reserva devolvida volta para 'disponivel'.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (estado) (delivery_estoque_unidades)",
     "legendFormat": "{{estado}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 35,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 4,
   "type": "row",
   "title": "2. Pagamentos e gateway",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Pagamentos por resultado (por minuto)",
   "description": "aprovado, recusado e estornado (a compensação da aprovação atrasada).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (resultado) (increase(delivery_pagamentos_total[1m]))",
     "legendFormat": "{{resultado}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Latência do gateway de pagamento",
   "description": "Com GATEWAY_LATENCIA_MS acima do prazo de pagamento, a linha passa do prazo e o pedido é cancelado (F7).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.50, sum by (le) (rate(delivery_gateway_duracao_ms_bucket[1m])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(delivery_gateway_duracao_ms_bucket[1m])))",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(delivery_gateway_duracao_ms_sum[1m])) / sum(rate(delivery_gateway_duracao_ms_count[1m]))",
     "legendFormat": "média",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 7,
   "type": "row",
   "title": "3. Filas, DLQs e outbox",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Mensagens prontas nas filas",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (queue) (rabbitmq_queue_messages_ready{queue!~\".*dlq|consultas.*\"})",
     "legendFormat": "{{queue}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Mensagens nas DLQs",
   "description": "Mensagem venenosa: depois de MAX_TENTATIVAS vai para a DLQ (F4).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 19,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (queue) (rabbitmq_queue_messages_ready{queue=~\".*dlq\"})",
     "legendFormat": "{{queue}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Outbox pendente por serviço",
   "description": "Com o RabbitMQ fora (F6) a API segue aceitando pedidos e as mensagens esperam aqui.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 19,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (service_name) (delivery_outbox_pendentes)",
     "legendFormat": "{{service_name}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 11,
   "type": "row",
   "title": "4. Réplicas e duplicadas",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Mensagens processadas por réplica do pagamento (por minuto)",
   "description": "Cada réplica é uma série: a carga se divide entre elas (F8).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service_instance_id) (increase(delivery_mensagens_total{service_name=\"pagamento\", resultado=\"processada\"}[1m]))",
     "legendFormat": "{{service_instance_id}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Duplicadas descartadas e erros (por minuto)",
   "description": "Inbox: a mesma mensagem 5 vezes tem um efeito só e quatro descartadas (F3).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service_name) (increase(delivery_mensagens_total{resultado=\"duplicada\"}[1m]))",
     "legendFormat": "duplicadas · {{service_name}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service_name) (increase(delivery_mensagens_total{resultado=\"erro\"}[1m]))",
     "legendFormat": "erros · {{service_name}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 14,
   "type": "row",
   "title": "5. Logs de erros e compensações",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 15,
   "type": "logs",
   "title": "Compensações, recusas e erros (no Explore, filtre por correlationId)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 37,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "refId": "A",
     "queryType": "range",
     "expr": "{service_name=~\".+\"} |~ \"(?i)cancelad|recusad|estornad|erro na mensagem|falhou|descartada|segurando\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "prettifyLogMessage": false
   }
  },
  {
   "id": 16,
   "type": "row",
   "title": "6. Quem fala com quem (todos os pedidos somados)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 47,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 17,
   "type": "nodeGraph",
   "title": "Quem fala com quem (ao vivo, todos os pedidos): vermelho = onde houve falha",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "description": "O desenho da arquitetura, vivo e somando todos os pedidos do período (não é só o pedido escolhido). Cada círculo é um serviço ou banco, cada seta é uma chamada. Quando algo falha (pagamento recusado, estoque esgotado, prazo vencido), o anel do serviço onde aconteceu fica vermelho na proporção das falhas.",
   "gridPos": {
    "x": 0,
    "y": 48,
    "w": 24,
    "h": 16
   },
   "targets": [
    {
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "refId": "A",
     "queryType": "serviceMap",
     "serviceMapQuery": ""
    }
   ],
   "options": {
    "nodes": {
     "mainStatUnit": "ms",
     "secondaryStatUnit": "reqps"
    },
    "edges": {}
   }
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
