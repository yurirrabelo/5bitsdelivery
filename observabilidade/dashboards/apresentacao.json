     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(delivery_gateway_duracao_ms_sum[$__range]))/sum(increase(delivery_gateway_duracao_ms_count[$__range]))",
     "refId": "A",
