  {
   "id": 1,
   "type": "table",
   "title": "1. Pedidos recentes: clique no número",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "description": "Cada linha é um pedido que terminou, com o resultado dele (sucesso, recusado, esgotado...). Clique no número para ver, ao lado, o caminho dele por cada serviço.",
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 8,
    "h": 13
   },
   "targets": [
    {
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "refId": "A",
     "queryType": "traceql",
     "tableType": "spans",
     "limit": 60,
     "spss": 5,
     "query": "{ span.pedido.resultado =~ \".+\" } | select(span.pedido.id, span.pedido.resultado)"
    }
   ],
   "transformations": [
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Start time"
       }
      ]
     }
    },
    {
     "id": "groupBy",
     "options": {
      "fields": {
       "pedido.id": {
        "aggregations": [],
        "operation": "groupby"
       },
       "traceIdHidden": {
        "aggregations": [],
        "operation": "groupby"
       },
       "Start time": {
        "aggregations": [
         "max"
        ],
        "operation": "aggregate"
       },
       "pedido.resultado": {
        "aggregations": [
         "lastNotNull"
        ],
        "operation": "aggregate"
       }
      }
     }
    },
    {
     "id": "organize",
     "options": {
      "renameByName": {
       "Start time (max)": "Hora",
       "pedido.resultado (lastNotNull)": "Resultado",
       "pedido.id": "Pedido nº"
      },
      "indexByName": {
       "Start time (max)": 0,
       "pedido.id": 1,
       "pedido.resultado (lastNotNull)": 2
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Hora",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "left",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "traceIdHidden"
      },
      "properties": [
       {
        "id": "custom.hidden",
        "value": true
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Hora"
      },
      "properties": [
       {
        "id": "unit",
        "value": "time: HH:mm:ss"
       },
       {
        "id": "custom.width",
        "value": 80
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Pedido nº"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 80
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       },
       {
        "id": "links",
        "value": [
         {
          "title": "Ver o caminho deste pedido",
          "url": "/d/apresentacao/apresentacao?orgId=1&var-traceid=${__data.fields.traceIdHidden}&${__url_time_range}&refresh=5s"
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Resultado"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "sucesso": {
            "text": "✅ Sucesso",
            "color": "green",
            "index": 0
           },
           "recusado": {
            "text": "❌ Recusado",
            "color": "red",
            "index": 1
           },
           "prazo_expirado": {
            "text": "⏱️ Demorou demais",
            "color": "orange",
            "index": 2
           },
           "esgotado": {
            "text": "😕 Esgotado",
            "color": "yellow",
            "index": 3
           },
           "estornado": {
            "text": "↩️ Estornado",
            "color": "purple",
            "index": 4
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "md"
   }
  },
  {
   "id": 2,
   "type": "table",
   "title": "2. O caminho do pedido escolhido, serviço por serviço",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "description": "O mesmo pedido visto por dentro: cada linha é um serviço trabalhando nele, na ordem em que aconteceu, e quanto tempo cada um demorou. Em vermelho, onde deu errado.",
   "gridPos": {
    "x": 8,
    "y": 17,
    "w": 16,
    "h": 13
   },
   "targets": [
    {
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "refId": "A",
     "queryType": "traceql",
     "tableType": "spans",
     "limit": 50,
     "spss": 50,
     "query": "{ trace:id = \"${traceid}\" && (kind = consumer || (kind = server && span.pedido.id > 0) || (resource.service.name = \"gateway-pagamento\" && kind = server)) } | select(span:name, resource.service.name, span:status, span:statusMessage, span.pedido.id)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "Clique em um pedido ao lado para ver o caminho dele",
