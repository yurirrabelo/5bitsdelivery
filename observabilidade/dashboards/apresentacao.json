  {
   "id": 12,
   "type": "timeseries",
   "title": "Pedidos por minuto",
   "description": "Quantos pedidos entraram a cada minuto. Sobe quando a turma pede pelo QR code.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "legendFormat": "pedidos",
     "expr": "sum(increase(delivery_pedidos_transicoes_total{status=\"RECEBIDO\"}[1m]))"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 3,
      "fillOpacity": 18,
      "showPoints": "never",
      "lineInterpolation": "smooth"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Quanto cada serviço demora (média)",
   "description": "Tempo médio que cada serviço leva para tratar uma mensagem da fila. Quanto mais alto, mais lento.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 9,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "legendFormat": "{{service}}",
     "expr": "sum by (service) (increase(traces_spanmetrics_latency_sum{span_kind=\"SPAN_KIND_CONSUMER\"}[2m])) / sum by (service) (increase(traces_spanmetrics_latency_count{span_kind=\"SPAN_KIND_CONSUMER\"}[2m]))"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 3,
      "fillOpacity": 18,
      "showPoints": "never",
      "lineInterpolation": "smooth"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
