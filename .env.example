# ---------- Entrada ----------
NGINX_PORTA=8080

# ---------- MiniStack (AWS emulada) ----------
MINISTACK_IMAGEM=ministackorg/ministack:1.5.41
AWS_ENDPOINT_URL=http://ministack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_ROTAS=delivery-rotas

# ---------- Bancos (um por serviço) ----------
DB_SENHA_PEDIDOS=dev-pedidos-123
DB_SENHA_ESTOQUE=dev-estoque-123
DB_SENHA_PAGAMENTO=dev-pagamento-123
DB_SENHA_ENTREGAS=dev-entregas-123

# ---------- RabbitMQ ----------
RABBITMQ_USUARIO=delivery
RABBITMQ_SENHA=dev-rabbit-123
RABBITMQ_EXCHANGE=delivery.eventos
RABBITMQ_DLX=delivery.dlx
FILA_PEDIDOS=pedidos.entrada
FILA_ESTOQUE=estoque.entrada
FILA_PAGAMENTO=pagamento.entrada
FILA_ENTREGAS=entregas.entrada
# Tentativas antes da DLQ, contando a primeira
MAX_TENTATIVAS=3

# ---------- Auth ----------
JWT_SEGREDO=troque-por-um-texto-longo-e-aleatorio
JWT_EXPIRACAO_HORAS=12
OPERADOR_USUARIO=operador
OPERADOR_SENHA=dev-operador-123
ENTREGADOR1_USUARIO=entregador1
ENTREGADOR1_SENHA=dev-entregador-123
ENTREGADOR1_NOME=Entregador Real
ENTREGADOR1_DEVICE_ID=ent1-troque-por-token-aleatorio
ENTREGADOR1_TELEGRAM_CHAT_ID=
ENTREGADOR2_USUARIO=entregador2
ENTREGADOR2_SENHA=dev-entregador-123
ENTREGADOR2_NOME=Entregador Simulado
ENTREGADOR2_DEVICE_ID=ent2-troque-por-token-aleatorio
# Código que vai no link do QR code
EVENTO_CODIGO=troque-por-um-codigo

# ---------- Regras ----------
PROMOCAO_NOME=Promoção relâmpago
PROMOCAO_QUANTIDADE=10
PRAZO_PAGAMENTO_SEG=15
CLIENTE_PEDIDOS_EM_ANDAMENTO=1
ORIGEM_NOME=Loja
# Centro de Blumenau; ajuste para as coordenadas da faculdade
ORIGEM_LAT=-26.9194
ORIGEM_LON=-49.0661
GEOFENCE_RAIO_M=50

# ---------- Gateway de pagamento simulado ----------
GATEWAY_LATENCIA_MS=0
# Porcentagem de cobranças que falham, de 0 a 100
GATEWAY_TAXA_FALHA=0
# Quanto o pagamento espera o gateway
GATEWAY_TIMEOUT_MS=60000
PAGAMENTO_REPLICAS=2

# ---------- Notificações ----------
# log | telegram | ntfy
NOTIFICACAO_PROVIDER=log
TELEGRAM_BOT_TOKEN=
NTFY_TOPICO=delivery-troque-por-nome-aleatorio

# ---------- Bônus (profile bonus) ----------
# CQRS: tabela do DynamoDB com a visão dos pedidos e a fila que recebe todas as mensagens
DYNAMODB_TABELA_VISAO=delivery-visao-pedidos
FILA_CONSULTAS=consultas.entrada
# Autoescala do pagamento: réplicas entre o mínimo (as do compose) e o máximo, uma a cada N mensagens na fila
AUTOSCALE_MIN=2
AUTOSCALE_MAX=6
AUTOSCALE_MENSAGENS_POR_REPLICA=10
AUTOSCALE_INTERVALO_SEG=5
AUTOSCALE_ESPERA_SEG=15

# ---------- Observabilidade ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
